{
  "name": "MathDys — cahier de maths",
  "short_name": "MathDys",
  "description": "Cahier de maths au clavier pour les élèves multi-dys. Aucun compte, tout reste sur ton ordinateur.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef0f4",
  "theme_color": "#2f6fde",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".mathdys"] } }
  ]
}
